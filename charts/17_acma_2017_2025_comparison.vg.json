{
  "title": {
    "text": "Online shopping participation: 2017 versus 2025",
    "subtitle": "ACMA percentage reporting buying goods or services online in past six months"
  },
  "width": "900",
  "height": 150,
  "data": {
    "url": "../data/acma_online_shopping_2017_2025.csv"
  },
  "mark": {
    "type": "point",
    "filled": true,
    "size": 180
  },
  "encoding": {
    "x": {
      "field": "percent",
      "type": "quantitative",
      "title": "Respondents (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "y": {
      "field": "period",
      "type": "ordinal",
      "title": null,
      "sort": [
        "2017",
        "2025"
      ]
    },
    "color": {
      "field": "period",
      "type": "nominal",
      "scale": {
        "domain": [
          "2017",
          "2025"
        ],
        "range": [
          "#457B9D",
          "#E87532"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "period"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#475569",
      "titleColor": "#172B4D",
      "gridColor": "#E5E7EB",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "anchor": "start",
      "color": "#172B4D",
      "fontSize": 18,
      "subtitleColor": "#64748B",
      "subtitleFontSize": 12
    }
  }
}
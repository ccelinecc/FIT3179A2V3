{
  "title": {
    "text": "Online shopping: metro and regional respondents",
    "subtitle": "ACMA 2025 survey results"
  },
  "width": "900",
  "height": 150,
  "data": {
    "url": "../data/acma_online_shopping_by_location_2025.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "title": null
    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "title": "Respondents (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Metro",
          "Regional"
        ],
        "range": [
          "#2A9D8F",
          "#457B9D"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "group"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#475569",
      "titleColor": "#172B4D",
      "gridColor": "#E5E7EB",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "anchor": "start",
      "color": "#172B4D",
      "fontSize": 18,
      "subtitleColor": "#64748B",
      "subtitleFontSize": 12
    }
  }
}
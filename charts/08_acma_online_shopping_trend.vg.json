
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australians buying goods or services online",
    "subtitle": "ACMA survey: percentage reporting activity in past six months"
  },
  "width": 900,
  "height": 280,
  "data": {
    "url": "../data/acma_online_shopping_trend.csv",
    "format": {
      "type": "csv"
    }
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 45
    },
    "strokeWidth": 2.5,
    "color": "#E87532"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Survey year",
      "sort": "ascending"
    },
    "y": {
      "field": "shopping_percent",
      "type": "quantitative",
      "title": "Respondents (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "format": ".0f"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Survey year"
      },
      {
        "field": "shopping_percent",
        "type": "quantitative",
        "title": "Respondents (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#475569",
      "titleColor": "#172B4D",
      "gridColor": "#E5E7EB",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "anchor": "start",
      "color": "#172B4D",
      "fontSize": 18,
      "subtitleColor": "#64748B",
      "subtitleFontSize": 12
    }
  }
}
